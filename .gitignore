# Dépendances et caches
node_modules/
.claude/skills/short-editing/.runtime/
.claude/skills/short-editing/engine/node_modules/

# Video Agent Skills (vidéos lourdes, clés)
video-agent/takes/*
!video-agent/takes/.gitkeep
video-agent/edits/**/*.mp4
video-agent/edits/**/assets/
video-agent/edits/**/stills/
video-agent/.tmp/
video-agent/.env
.env

# Rendus (on versionne les sources, pas les exports lourds)
exports/**/*.mp4
exports/**/*.mov
exports/**/*.webm
remotion/out/

# Sources audio/vidéo brutes (trop lourdes pour git)
assets/voice/*.wav
assets/video/*.mp4
assets/video/*.mov

# Générés par engine/setup.mjs (régénérables, ~57 Mo)
.claude/skills/short-editing/assets/music/*.mp3
.claude/skills/short-editing/assets/icons/*.png
